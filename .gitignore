# Generated artifacts — regenerate with run_phase1_2.py (deterministic seed).
# Reports, manifests and CSV ledgers ARE committed: they are the evidence.
*.parquet
__pycache__/
data/raw/merged_eod/
# live capture: uncompressed segments and status are runtime state; compressed
# segments + MANIFEST are committed after the session as evidence
evidence/capture/*/segments/*.jsonl
evidence/capture/*/STATUS.json
evidence/capture/*/STATUS.json.tmp
evidence/capture/*/runner.log
.pytest_cache/
results/tower/
tower/ingest/ingest
tower/ingest/*.test
tests/tower/_ui_screenshot.png

# public collector: the whole runtime output tree (raw payloads, normalized tables,
# metadata) lives under runtime/ and is regenerated with
# python3 -m collector.dse_public_collector; the run's metadata + small normalized
# tables are committed under evidence/public/<date>/ instead. Keeping it out of data/
# matters: data/ holds tracked source (ingest_dse_eod.py, make_synthetic.py).
runtime/
